# OS junk (per-skill folders keep their own .gitignore for Python/venv/output)
.DS_Store
Thumbs.db
desktop.ini

# Backup copies of templates. Git already holds every prior version, so a .bak
# alongside the file it shadows is a second source of truth that goes stale.
*.bak
*.bak_*

# The logo fetchers are node scripts, so running one drops a node_modules beside the
# skill. The PNGs it produces are committed; the toolchain that produced them is not.
node_modules/

# Python bytecode from running the root scripts (install.py, tools/).
__pycache__/
*.py[cod]

# Written by the installer INTO the install directory, and specific to that machine:
# bin/aiws.cmd pins an absolute interpreter path, and .aiws-version records which commit
# that machine took. Both are regenerated by the installer; neither belongs to the repo.
bin/
.aiws-version
