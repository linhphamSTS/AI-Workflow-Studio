# Normalize all text to LF in the repo (and on checkout), so shell scripts never get
# CRLF and break bash on macOS/Linux. Windows batch files keep CRLF.
* text=auto eol=lf

*.sh        text eol=lf
*.command   text eol=lf
*.py        text eol=lf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary assets — never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.docx binary
*.doc  binary
*.xlsx binary
*.xls  binary
*.zip  binary
*.woff binary
*.woff2 binary
